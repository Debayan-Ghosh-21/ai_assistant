  {
    "id": "layer:infrastructure",
    "name": "Infrastructure and Orchestration",
    "description": "Multi-stage Dockerfiles, Docker Compose service configurations, and supervisord orchestrators.",
    "nodeIds": [
      "service:docker-compose.yml",
      "service:Dockerfile",
      "service:Dockerfile:builder",
      "service:Dockerfile:runtime",
      "pipeline:Dockerfile:FROM python:3.12-slim-bookworm AS builder",
      "pipeline:Dockerfile:COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/",
      "pipeline:Dockerfile:RUN apt-get update && apt-get install -y --no-install-recommends",
      "pipeline:Dockerfile:ENV MAKEFLAGS=\"-j$(nproc)\"",
      "pipeline:Dockerfile:ENV PYTHONDONTWRITEBYTECODE=1",
      "pipeline:Dockerfile:ENV PYTHONUNBUFFERED=1",
      "pipeline:Dockerfile:ENV UV_COMPILE_BYTECODE=1",
      "pipeline:Dockerfile:ENV UV_LINK_MODE=copy",
      "pipeline:Dockerfile:WORKDIR /app",
      "pipeline:Dockerfile:COPY pyproject.toml uv.lock ./",
      "pipeline:Dockerfile:COPY open_notebook/__init__.py ./open_notebook/__init__.py",
      "pipeline:Dockerfile:RUN uv sync --frozen --no-dev",
      "pipeline:Dockerfile:ENV TIKTOKEN_CACHE_DIR=/app/tiktoken-cache",
      "pipeline:Dockerfile:RUN mkdir -p /app/tiktoken-cache && \\",
      "pipeline:Dockerfile:COPY . /app",
      "pipeline:Dockerfile:WORKDIR /app/frontend",
      "pipeline:Dockerfile:ARG NPM_REGISTRY=https://registry.npmjs.org/",
      "pipeline:Dockerfile:COPY frontend/package.json frontend/package-lock.json ./",
      "pipeline:Dockerfile:RUN npm config set registry ${NPM_REGISTRY}",
      "pipeline:Dockerfile:RUN npm ci",
      "pipeline:Dockerfile:COPY frontend/ ./",
      "pipeline:Dockerfile:RUN npm run build",
      "pipeline:Dockerfile:FROM python:3.12-slim-bookworm AS runtime",
      "pipeline:Dockerfile:RUN apt-get update && apt-get upgrade -y && apt-get install -y -",
      "pipeline:Dockerfile:COPY --from=builder /app/.venv /app/.venv",
      "pipeline:Dockerfile:COPY --from=builder /app/tiktoken-cache /app/tiktoken-cache",
      "pipeline:Dockerfile:ENV UV_NO_SYNC=1",
      "pipeline:Dockerfile:ENV VIRTUAL_ENV=/app/.venv",
